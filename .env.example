# Tidak perlu disalin manual: `npm run seed` membuat .env otomatis.
# Berikut variabel yang dikenali:
PORT=3000
JWT_SECRET=isi-string-acak-minimal-32-karakter
COOKIE_SECURE=0   # lokal HTTP = 0; production HTTPS = 1
TRUST_PROXY=0     # 1 HANYA jika Node berada di belakang reverse proxy terpercaya
# DB_PATH=./data/app.db
APP_URL=http://localhost:3000
# Email (kosongkan SMTP_HOST untuk mode pengembangan: email dicetak di konsol)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=emailpengirim@gmail.com
# SMTP_PASS=sandi-aplikasi
# SMTP_FROM=Panduan Sholat <emailpengirim@gmail.com>
